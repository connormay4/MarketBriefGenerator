{
  "name": "competitor-research-tool",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "server": "node --env-file=.env --disable-warning=ExperimentalWarning server/index.js",
    "client": "cd client && npm run dev",
    "install:all": "npm install && cd client && npm install"
  },
  "dependencies": {
    "@google/genai": "^2.7.0",
    "concurrently": "^8.2.2",
    "cors": "^2.8.5",
    "express": "^4.18.3"
  }
}
