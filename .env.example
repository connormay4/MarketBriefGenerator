# ─── Core (required today) ────────────────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here
GOOGLE_PLACES_API_KEY=your_google_places_api_key_here
LOCATION="Hanover, PA 17331"
PORT=3001

# ─── AI model overrides (optional) ────────────────────────────────────────────
# Pinned IDs chosen for cost. Override only if the API rejects an ID.
#   GEMINI_GROUNDING_MODEL=gemini-3-flash-preview   # competitor news (free grounding quota)
#   GEMINI_SYNTHESIS_MODEL=gemini-2.5-flash         # brief prose
#   GEMINI_CLASSIFY_MODEL=gemini-2.5-flash-lite     # review aspect classification (Phase 2)
# Optional second vendor for the cheapest classifier (GPT-5 Nano). If unset, the
# single Gemini key is used for classification too.
#   OPENAI_API_KEY=sk-...

# ─── Database (Turso / libSQL) ────────────────────────────────────────────────
# Production: a hosted Turso DB so data PERSISTS across Vercel invocations.
# Local dev: leave BOTH unset to use a local ./data/briefs.db file automatically.
#   TURSO_DATABASE_URL=libsql://your-db.turso.io
#   TURSO_AUTH_TOKEN=your_turso_auth_token
# Optional: override the local file location (ignored when TURSO_DATABASE_URL set).
#   DATA_DIR=./data

# ─── Weekly email (Phase 1) ───────────────────────────────────────────────────
#   RESEND_API_KEY=re_...
#   EMAIL_FROM="CFA Market Intel <brief@yourdomain.com>"
#   EMAIL_TO=jack.stefano@cfafranchisee.com
# Shared secret Vercel Cron sends as `Authorization: Bearer <CRON_SECRET>`.
#   CRON_SECRET=long_random_string

# ─── 25-CFA ranking (Phase 2) ─────────────────────────────────────────────────
# Outscraper key for high-volume Google reviews (Places caps at 5/place).
#   OUTSCRAPER_API_KEY=...
# This store's Google Place ID (Jack's CFA) — anchors discovery of nearby CFAs.
#   STORE_PLACE_ID=...
